# Panya local bridge
PORT=3000
# Standalone Panya-only bridge (safe to expose through a tunnel).
PANYA_PORT=3100
# Telegram Drive REST API (Settings → Advanced in the desktop app).
PANYA_TELEGRAM_API_URL=http://127.0.0.1:8550/api/v1
PANYA_TELEGRAM_API_KEY=REPLACE_WITH_64_HEX_API_KEY
# Dedicated Telegram Drive folder. Use the id returned by GET /api/v1/folders,
# or omit it and set PANYA_TELEGRAM_FOLDER_NAME so the bridge can find/create it.
PANYA_TELEGRAM_FOLDER_ID=
PANYA_TELEGRAM_FOLDER_NAME=Panya
# Optional. On the public Vercel deployment, set this to the tunnel API base,
# for example https://your-tunnel.trycloudflare.com/panya/api
PANYA_PUBLIC_API_BASE=
# Comma-separated origins, or * for public read/upload.
PANYA_ALLOWED_ORIGINS=*
# Cloudflare Free tunnels cap request bodies at ~100 MB; 95 keeps the UI honest.
PANYA_MAX_UPLOAD_MB=95
# Local captions/original names (media stays in Telegram Drive).
PANYA_DATA_DIR=.panya-data
